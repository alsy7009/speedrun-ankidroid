<?xml version="1.0" encoding="utf-8"?>
<!-- Speedrun native app themes. Each palette inherits the full Light theme
     (deck list, study buttons, dialogs, browser, etc.) and overrides only the
     colour tokens. appBarColor / statusBar / tabLayout / widgetColorActivated
     reference ?attr/colorPrimary in the parent, so the whole app shell adopts
     the palette accent automatically. Mirrors qt/aqt/speedrun_themes.py. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">

    <style name="Theme_Speedrun_Matcha" parent="Theme_Light">
        <item name="colorPrimary">@color/sr_matcha_accent</item>
        <item name="colorPrimaryDark">@color/sr_matcha_accent_dark</item>
        <item name="colorAccent">@color/sr_matcha_accent</item>
        <item name="colorSurface">@color/sr_matcha_surface</item>
        <item name="colorOnSurface">@color/sr_matcha_ink</item>
        <item name="colorSurfaceContainerLow">@color/sr_matcha_bg</item>
        <item name="colorSurfaceContainer">@color/sr_matcha_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sr_matcha_line</item>
        <item name="colorSurfaceContainerHighest">@color/sr_matcha_line</item>
        <item name="android:colorBackground">@color/sr_matcha_bg</item>
        <item name="android:windowBackground">@color/sr_matcha_bg</item>
        <item name="android:textColor">@color/sr_matcha_ink</item>
        <item name="android:textColorSecondary">@color/sr_matcha_muted</item>
        <item name="preferenceCategoryTitleTextColor">@color/sr_matcha_accent</item>
        <item name="currentDeckBackgroundColor">@color/sr_matcha_line</item>
        <item name="focusedRowBackgroundColor">@color/sr_matcha_line</item>
        <item name="alternativeBackgroundColor">@color/sr_matcha_surface</item>
        <item name="dialogBackground">@color/sr_matcha_surface</item>
        <item name="popupBackgroundColor">@color/sr_matcha_surface</item>
        <item name="newCountColor">@color/sr_matcha_accent</item>
        <item name="fab_normal">@color/sr_matcha_accent</item>
        <item name="fab_pressed">@color/sr_matcha_accent_dark</item>
        <item name="snackbarBackgroundTintColor">@color/sr_matcha_ink</item>
    </style>

